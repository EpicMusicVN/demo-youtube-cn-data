# API KEY
YOUTUBE_API_KEY=your_youtube_api_key
GEMINI_API_KEY=your_gemini_api_key
VERTEX_API_KEY=your_vertex_api_key
VERTEX_MODEL=gemini-3.5-flash

#CONFIG
VIDEO_OUTPUT_MAX=10
VIDEO_FETCH_MAX=50
ANALYSIS_BUDGET_SECONDS=90
HTTP_TIMEOUT=30
VERTEX_TIMEOUT=90
ENV=

# DATABASE (docker-compose sets this automatically when using postgres service)
DATABASE_URL=postgresql://cnl:cnlpass@localhost:5432/cnldb
